# Your Canvas instance (no trailing slash)
CANVAS_BASE=https://canvas.cityu.edu.hk

# Personal access token.
# Create one at https://canvas.cityu.edu.hk/profile/settings → "+ New Access Token".
# It is shown only once — copy it before closing the dialog.
CANVAS_TOKEN=

# Local port for the dashboard
PORT=5173

# Interface to bind to. Leave unset for local-only use (127.0.0.1 default).
# Set to 0.0.0.0 only inside a container/cloud deployment.
HOST=127.0.0.1

# HTTP Basic Auth — required if this is ever reachable from outside your
# own machine (e.g. deployed to Docker/Azure). Leave both unset for local use.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
